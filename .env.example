# Salin jadi .env lalu sesuaikan. Docker Compose otomatis membaca file .env.

POSTGRES_PASSWORD=change-me
APP_PORT=8080

# manual = aktivasi langganan instan (development/admin).
# midtrans|stripe|telegram menyusul setelah gateway dipasang.
BILLING_MODE=manual

MAX_FILESIZE_MB=500
JOB_TIMEOUT_MINUTES=20
MAX_ATTEMPTS=3
WORKER_CONCURRENCY=2
