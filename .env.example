# Salin jadi .env lalu sesuaikan. Docker Compose otomatis membaca file .env.

POSTGRES_PASSWORD=change-me
APP_PORT=8080

# manual = aktivasi langganan instan (development/admin).
# midtrans = Midtrans Snap (QRIS, GoPay, VA, kartu) — isi server key di bawah,
#            lalu set Notification URL Midtrans ke:
#            https://<domain>/api/billing/webhook/midtrans
BILLING_MODE=manual

# Kredensial Midtrans (dashboard → Settings → Access Keys).
# Kosong + BILLING_MODE=midtrans → endpoint checkout 501 dengan pesan jelas.
# Untuk testing webhook lokal, pakai tunnel (cloudflared/ngrok) dan arahkan
# Notification URL Midtrans ke endpoint /api/billing/webhook/midtrans.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Bot Telegram (token dari @BotFather; kosong = service bot idle).
# PUBLIC_BASE_URL dipakai bot untuk membuat link file (ubah saat deploy).
TELEGRAM_BOT_TOKEN=
PUBLIC_BASE_URL=http://localhost:8080

# Akun admin dibuat/dipromosikan saat API start (kosongkan untuk melewati).
# Ganti kredensial ini di produksi!
ADMIN_EMAIL=admin@vidgrab.local
ADMIN_PASSWORD=admin12345

MAX_FILESIZE_MB=500
JOB_TIMEOUT_MINUTES=20
MAX_ATTEMPTS=3
WORKER_CONCURRENCY=2
