# Salin jadi .env lalu sesuaikan. Docker Compose otomatis membaca file .env.

POSTGRES_PASSWORD=change-me
APP_PORT=8080

# manual = aktivasi langganan instan (development/admin).
# midtrans = Midtrans Snap (QRIS, GoPay, VA, kartu) — isi server key di bawah,
#            lalu set Notification URL Midtrans ke:
#            https://<domain>/api/billing/webhook/midtrans
BILLING_MODE=manual

# Kredensial Midtrans (dashboard → Settings → Access Keys).
# HANYA Server Key yang dipakai: transaksi dibuat backend lalu user
# diarahkan ke halaman Snap (Snap redirect). Client Key tidak diperlukan
# karena frontend tidak memakai Snap.js embed.
# Kosong + BILLING_MODE=midtrans → endpoint checkout 501 dengan pesan jelas.
# Untuk testing webhook lokal, pakai tunnel (cloudflared/ngrok) dan arahkan
# Notification URL Midtrans ke endpoint /api/billing/webhook/midtrans.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# URL publik aplikasi. Dipakai sebagai tujuan redirect Snap setelah bayar
# (PUBLIC_BASE_URL/?payment=<id>) — ubah ke domain/tunnel saat deploy.
PUBLIC_BASE_URL=http://localhost:8080

# Akun admin dibuat/dipromosikan saat API start (kosongkan untuk melewati).
# Ganti kredensial ini di produksi!
ADMIN_EMAIL=admin@vidgrab.local
ADMIN_PASSWORD=admin12345

MAX_FILESIZE_MB=500
JOB_TIMEOUT_MINUTES=20
MAX_ATTEMPTS=3
WORKER_CONCURRENCY=2

# yt-dlp: cookies & proxy (opsional)
# Banyak situs memblokir IP datacenter (TikTok, YouTube). Bila unduhan ditolak
# dengan pesan anti-bot, sediakan cookies hasil ekspor browser (format Netscape)
# di ./secrets/cookies.txt -- berkas di-mount read-only ke container dan
# diteruskan sebagai --cookies. Berkas tidak ada = argumen dilewati.
YTDLP_COOKIES_FILE=/data/secrets/cookies.txt
# Alternatif: proxy dengan IP bersih (residensial/mobile):
#   http://user:pass@host:port  atau  socks5://host:port
YTDLP_PROXY=
